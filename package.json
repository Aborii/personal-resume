{
  "name": "personal-resume",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pages:dev": "wrangler pages dev out",
    "deploy": "npm run build && wrangler pages deploy out",
    "g:og": "tsx scripts/generate-og-images.ts",
    "g:pdf": "tsx scripts/generate-pdf.ts",
    "g:docx": "tsx scripts/generate-docx.ts",
    "g:md": "tsx scripts/generate-md.ts",
    "g:resume": "npm run g:pdf && npm run g:docx && npm run g:md",
    "g:all": "npm run g:resume && npm run g:og",
    "prepare": "husky"
  },
  "dependencies": {
    "@types/file-saver": "^2.0.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.5.1",
    "file-saver": "^2.0.5",
    "jspdf": "^4.0.0",
    "next": "^16.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vercel/og": "^0.8.6",
    "baseline-browser-mapping": "^2.9.14",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.2",
    "husky": "^9.1.7",
    "playwright": "^1.57.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.59.2"
  }
}
